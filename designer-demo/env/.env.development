# development mode, used by the "vite" command

NODE_ENV=development
VITE_CDN_DOMAIN=https://registry.npmmirror.com
# 使用npmmirror的cdn 时，需要声明 VITE_CDN_TYPE=npmmirror
VITE_CDN_TYPE=npmmirror
# request data via alpha service
# VITE_ORIGIN=

# 本地联调时从「主工程」或模拟 bundle 加载物料，逗号分隔多个 URL（与插件 getInitData/materialBundleUrls 同效，见文档 十二、VSCode-Integration）
# 同源可避免 CORS，例如设计器 8090 时用：http://localhost:8090/mock/main-project-bundle/bundle.json
VITE_MATERIAL_BUNDLE_URLS=http://localhost:8090/mock/main-project-bundle/bundle.json
