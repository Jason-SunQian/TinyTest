# development mode, used by the "vite" command

NODE_ENV=development
VITE_CDN_DOMAIN=https://registry.npmmirror.com
# 使用npmmirror的cdn 时，需要声明 VITE_CDN_TYPE=npmmirror
VITE_CDN_TYPE=npmmirror
# request data via alpha service
# VITE_ORIGIN=

# 本地联调时从「主工程」加载物料，逗号分隔多个 URL（与插件 HTML 注入 window.TINY_MATERIAL_BUNDLE_URLS 同效）
# 示例：主工程在 3000 端口 serve dist/lowcode-materials/bundle.json 时，可写：
# VITE_MATERIAL_BUNDLE_URLS=http://localhost:3000/bundle.json
VITE_MATERIAL_BUNDLE_URLS=

# 物料脚本/样式的 base URL（可选），仅在无法从 bundle URL 推导时作为回退。
# 示例：VITE_MATERIALS_BASE_URL=http://localhost:3000
VITE_MATERIALS_BASE_URL=
