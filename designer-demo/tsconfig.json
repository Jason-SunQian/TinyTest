{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "composite": false,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "useDefineForClassFields": true,
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "env.d.ts",
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "registry.js",
    "registry.ts",
    "vite.config.js",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "../packages",
    "../mockServer",
    "../scripts",
    "../designer-demo/tests"
  ]
}

